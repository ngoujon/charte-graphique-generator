FROM node:20-alpine
WORKDIR /app

# Install all deps (client + server + root)
COPY package*.json ./
COPY client/package*.json ./client/
COPY server/package*.json ./server/
COPY shared/package*.json ./shared/

RUN npm install && cd shared && npm install && cd ../client && npm install && cd ../server && npm install
RUN chmod -R a+rX /app

# Source monté en volume, pas copié
# On garde node_modules du build

ENV NODE_ENV=development
ENV PORT=3002
ENV DATA_DIR=/app/data

EXPOSE 3002

CMD ["npm", "run", "dev"]
